{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "cafecaogia",
  // Keep the *.workers.dev address too, for checks that bypass the custom domains.
  "workers_dev": true,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding, must match the worker name
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cafecaogia"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "d1_databases": [
    {
      // CMS content, inquiries and admin accounts. Schema + seed: migrations/ (`npm run db:migrate`).
      "binding": "DB",
      "database_name": "caogia-db",
      "database_id": "db924c0c-b091-4f84-bfa7-d85afbae01c5",
      "migrations_dir": "migrations"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "caogia-tag-cache",
      "database_id": "d23219db-3fa4-43ad-a635-9ac27ea02a09"
    }
  ],
  // Rendered pages (ISR). Images stay on Cloudinary, so no R2 is needed.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "48755a8639e64af894dbfc988b21d25c"
    }
  ],
  // Public, non-secret values. Secrets (AUTH_SECRET, RESEND_API_KEY, …) go in via `wrangler secret put`.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.cafecaogia.com",
    "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME": "dq6mmebqr",
    // Inquiry auto-reply sender. Its GMAIL_CLIENT_ID / _SECRET / _REFRESH_TOKEN are secrets.
    "GMAIL_SENDER": "Cao Gia <davidcao.cg@gmail.com>"
  }
}
