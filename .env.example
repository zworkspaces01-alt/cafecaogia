# Public site URL (used for metadata, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary — the cloud name serves images; the API key/secret let the CMS upload them.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase — project URL and publishable (or anon) key. Never use the service_role/secret key here.
# If unset, the production project's URL + publishable key built into src/lib/supabase-env.ts are used.
# Set SUPABASE_DISABLED=1 to run on the bundled sample content instead (CMS disabled).
# (SUPABASE_URL / SUPABASE_ANON_KEY are also accepted.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email alerts for new inquiries (https://resend.com). Verify your sending domain in Resend first.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL="Cao Gia Website <website@cafecaogia.com>"
# Comma-separated list of recipients
INQUIRY_NOTIFY_TO=caogiaxk2022@gmail.com,davidcaocg@gmail.com

# Auto-reply to buyers, sent through the Gmail API from the account below (README → "Email tự động cho khách").
# Get the refresh token with `npm run gmail:auth`. On Cloudflare the three GMAIL_* values below are secrets.
GMAIL_SENDER="Cao Gia <davidcao.cg@gmail.com>"
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Telegram notifications — token from @BotFather. Group and topics are set in CMS → Thông báo.
# Secret: on Cloudflare use `npx wrangler secret put TELEGRAM_BOT_TOKEN`, never wrangler.jsonc vars.
TELEGRAM_BOT_TOKEN=
